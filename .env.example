# Postgres
DATABASE_URL="postgresql://jonas:jonas@localhost:5432/jonas_vendas"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Auth do painel (usuário/senha únicos)
ADMIN_USER="admin"
ADMIN_PASSWORD="troque-esta-senha"
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Webhook de entrada (o app de chat externo envia pra cá)
INBOUND_WEBHOOK_TOKEN="troque-por-um-token-aleatorio"

# OpenAI — a key "de produção" é configurada no painel (tabela Settings).
# Esta aqui é opcional, usada só como fallback em dev/seed.
OPENAI_API_KEY=""
